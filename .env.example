# Copy to .env. Everything works with no keys (rules-only advisor, browser speech, WhatsApp simulator).
# ENVIRONMENT: dev | demo (judge demo: judge mode allowed) | prod (refuses to start on demo settings)
ENVIRONMENT=dev
# 32 random bytes, base64 (Secret Manager in the cloud). Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY_B64=

# Advisor and the second document reader: Claude
LLM_PROVIDER=none          # anthropic to switch it on
LLM_API_KEY=
LLM_MODEL=                 # default claude-opus-5-5

# Voice in 10 Indian languages (optional; browser speech otherwise)
SARVAM_API_KEY=

# Database: SQLite by default; Postgres in the cloud
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/udyam
# REDIS_URL=redis://localhost:6379/0     # live tracker across instances
# STORAGE_BACKEND=gcs  STORAGE_BUCKET=   # encrypted documents in Cloud Storage

# WhatsApp Cloud API (optional; the in-app simulator works without it)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=accel-verify
WHATSAPP_APP_SECRET=       # required in prod: verifies X-Hub-Signature-256
PUBLIC_URL=http://localhost:8000

# Staff (partners, reviewers, ops, admin). Demo accounts exist only with JUDGE_MODE=true.
# STAFF_ACCOUNTS={"asha":{"secret":"...","role":"reviewer","name":"Asha"}}
JUDGE_MODE=true
MOCK_ADAPTERS_ALLOWED=true
CORS_ORIGINS=*
